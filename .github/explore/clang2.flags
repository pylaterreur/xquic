# hardening
-U_FORTIFY_SOURCE
-D_FORTIFY_SOURCE=3
-fstack-protector-strong
-fstack-clash-protection
-fcf-protection
# warnings
-Weverything
-Wno-padded
-Wno-declaration-after-statement
-Wno-unsafe-buffer-usage
-Wno-pre-c11-compat
-Wno-pre-c23-compat
-Wno-c++-compat
-Wunused
-Wunused-parameter
-Wunused-macros
-Wunused-but-set-parameter
-Wunused-but-set-variable
-Wunused-const-variable
-Wpointer-sign
-Wformat-security
