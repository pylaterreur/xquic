# hardening
-U_FORTIFY_SOURCE
-D_FORTIFY_SOURCE=3
-fstack-protector-strong
-fstack-clash-protection
-fcf-protection
# warnings
-Wall
-Wextra
-Wpedantic
-Wshadow
-Wconversion
-Wsign-conversion
-Wfloat-conversion
-Warith-conversion
-Wenum-conversion
-Wenum-int-mismatch
-Wformat=2
-Wformat-signedness
-Wformat-overflow=2
-Wformat-truncation=2
-Wnull-dereference
-Wduplicated-cond
-Wduplicated-branches
-Wlogical-op
-Wcast-align=strict
-Wcast-qual
-Wcast-function-type
-Wstrict-prototypes
-Wmissing-prototypes
-Wmissing-declarations
-Wmissing-variable-declarations
-Wold-style-definition
-Wold-style-declaration
-Wmissing-parameter-type
-Wundef
-Wvla
-Wswitch-enum
-Wswitch-default
-Wpointer-arith
-Wwrite-strings
-Wredundant-decls
-Wnested-externs
-Wbad-function-cast
-Wdouble-promotion
-Wfloat-equal
-Wjump-misses-init
-Wstack-protector
-Walloca
-Walloc-zero
-Wstringop-overflow=4
-Warray-bounds=2
-Wshift-overflow=2
-Wtrampolines
-Wimplicit-fallthrough
-Wunused
-Wunused-parameter
-Wunused-macros
-Wunused-const-variable=2
-Wunused-but-set-parameter
-Wpointer-sign
-Winit-self
-Wmissing-include-dirs
-Wsuggest-attribute=format
-Wsuggest-attribute=noreturn
-Wmissing-format-attribute
-Wpacked
-Wdate-time
-Wflex-array-member-not-at-end
-Wcalloc-transposed-args
-Wdangling-pointer=2
-Wuse-after-free=3
-Wstrict-overflow=2
-Wdisabled-optimization
-Wvector-operation-performance
-Wmissing-noreturn
-Wstrict-aliasing=2
-Walloc-size
-Wduplicate-decl-specifier
-Wformat-y2k
-Wtype-limits
-Wsign-compare
